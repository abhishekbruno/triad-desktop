/* TRIAD — Desktop Workspace Dark Theme */

QMainWindow {
    background-color: #0e1015;
    color: #e2e8f0;
}

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    color: #cbd5e1;
}

/* Header Banner */
#HeaderWidget {
    background-color: #14171f;
    border-bottom: 1px solid #232733;
    padding: 16px 24px;
}

#AppTitleLabel {
    font-size: 18px;
    font-weight: 700;
    color: #f8fafc;
    letter-spacing: 0.5px;
}

#AppSubtitleLabel {
    font-size: 12px;
    color: #94a3b8;
    margin-top: 2px;
}

#StatusSummaryBadge {
    background-color: #1a202c;
    border: 1px solid #2d3748;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
    color: #94a3b8;
}

#StatusSummaryBadge[ready="true"] {
    background-color: #064e3b;
    border: 1px solid #059669;
    color: #34d399;
}

/* Tab Navigation */
QTabWidget::pane {
    border: none;
    background-color: #0e1015;
}

QTabBar::tab {
    background-color: #12151d;
    border: 1px solid #1e222e;
    border-bottom: none;
    color: #94a3b8;
    padding: 9px 20px;
    font-weight: 600;
    font-size: 12px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #1a1e28;
    color: #38bdf8;
    border-bottom: 2px solid #38bdf8;
}

QTabBar::tab:hover:!selected {
    background-color: #161922;
    color: #e2e8f0;
}

/* Global Controls Bar */
#GlobalControlsBar {
    background-color: #12151d;
    border-bottom: 1px solid #202430;
    padding: 10px 24px;
}

QPushButton.global-btn {
    background-color: #1e2330;
    border: 1px solid #2d3345;
    border-radius: 6px;
    padding: 7px 16px;
    font-weight: 500;
    color: #e2e8f0;
}

QPushButton.global-btn:hover {
    background-color: #283042;
    border-color: #3e485e;
}

QPushButton.global-btn:pressed {
    background-color: #181d28;
}

QPushButton.global-btn-primary {
    background-color: #2563eb;
    border: 1px solid #3b82f6;
    color: #ffffff;
    font-weight: 600;
}

QPushButton.global-btn-primary:hover {
    background-color: #1d4ed8;
    border-color: #60a5fa;
}

/* Agent Card */
QFrame.agent-card {
    background-color: #141720;
    border: 1px solid #242938;
    border-radius: 10px;
    margin: 6px;
}

QFrame.agent-card:hover {
    border-color: #333a4f;
}

#CardHeader {
    padding: 14px 18px 10px 18px;
    border-bottom: 1px solid #1c212e;
}

#AgentNameLabel {
    font-size: 16px;
    font-weight: 600;
    color: #f1f5f9;
}

#AccentIndicator {
    border-radius: 3px;
}

/* Status Pill */
QLabel.status-pill {
    font-size: 11px;
    font-weight: 600;
    border-radius: 12px;
    padding: 3px 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QLabel.status-pill[status="missing"] {
    background-color: #262933;
    color: #94a3b8;
    border: 1px solid #383e4d;
}

QLabel.status-pill[status="detected"] {
    background-color: #2e2612;
    color: #fbbf24;
    border: 1px solid #78350f;
}

QLabel.status-pill[status="bound"] {
    background-color: #064e3b;
    color: #34d399;
    border: 1px solid #059669;
}

QLabel.status-pill[status="stale"] {
    background-color: #450a0a;
    color: #f87171;
    border: 1px solid #991b1b;
}

/* Card Body Details */
#CardDetailsPanel {
    padding: 14px 18px;
}

.detail-label {
    font-size: 11px;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
}

.detail-value {
    font-size: 12px;
    color: #cbd5e1;
    font-family: "Consolas", "Courier New", monospace;
    background-color: #0d0f14;
    border: 1px solid #1a1e28;
    border-radius: 4px;
    padding: 4px 8px;
}

/* Card Action Buttons */
#CardActionsPanel {
    padding: 10px 18px 16px 18px;
    border-top: 1px solid #1c212e;
}

QPushButton.card-btn {
    border-radius: 5px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton.btn-connect {
    background-color: #1e293b;
    border: 1px solid #334155;
    color: #e2e8f0;
}

QPushButton.btn-connect:hover {
    background-color: #334155;
    border-color: #475569;
}

QPushButton.btn-focus {
    background-color: #0f766e;
    border: 1px solid #14b8a6;
    color: #ffffff;
    font-weight: 600;
}

QPushButton.btn-focus:hover {
    background-color: #115e59;
}

QPushButton.btn-disconnect {
    background-color: #1e1b2e;
    border: 1px solid #3f2d54;
    color: #c084fc;
}

QPushButton.btn-disconnect:hover {
    background-color: #2e1d44;
}

QPushButton:disabled {
    background-color: #12141a;
    border: 1px solid #1e222d;
    color: #475569;
}

/* Inputs & Form Elements */
QLineEdit, QTextEdit {
    background-color: #0d0f15;
    border: 1px solid #232838;
    border-radius: 6px;
    color: #f1f5f9;
    padding: 8px;
}

QLineEdit:focus, QTextEdit:focus {
    border-color: #3b82f6;
}

QComboBox {
    background-color: #161922;
    border: 1px solid #282f42;
    border-radius: 5px;
    color: #e2e8f0;
    padding: 6px 12px;
}

/* Activity Log Panel */
#ActivityLogWidget {
    background-color: #0b0d11;
    border-top: 1px solid #1a1e28;
    padding: 8px 18px;
}

#ActivityLogText {
    background-color: #090a0e;
    border: 1px solid #171b24;
    border-radius: 6px;
    color: #94a3b8;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 11px;
    padding: 6px;
}

/* Dialog Styles */
QDialog {
    background-color: #12151c;
    color: #f1f5f9;
}

QTableWidget {
    background-color: #0d0f14;
    border: 1px solid #232838;
    gridline-color: #1c212e;
    color: #cbd5e1;
    selection-background-color: #1e3a8a;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #161a24;
    border: 1px solid #232838;
    color: #94a3b8;
    padding: 6px;
    font-weight: 600;
}
